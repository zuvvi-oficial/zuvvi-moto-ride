# Server-only configuration.
# Copy this file to a local .env when needed and fill values outside Git.
# Never commit real credentials. Never expose server secrets with a VITE_ prefix.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Segredo compartilhado com o workflow agendado que chama
# /api/internal/pix-reconciliar-pendentes (ver .github/workflows/pix-reconciliacao-pix-pendentes.yml).
PIX_RECONCILIACAO_CRON_SECRET=

# Segredo compartilhado com o workflow agendado que chama
# /api/internal/corridas-agendadas-converter (ver .github/workflows/corridas-agendadas-converter.yml).
CORRIDAS_AGENDADAS_CRON_SECRET=

# Web Push (notificação no celular com o app fechado). Sem estas duas, o app
# não envia push nenhum e nem consegue inscrever aparelhos — silenciosamente.
#
# Gere o par uma única vez com:
#   node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log('publica:',publicKey.export({type:'spki',format:'der'}).subarray(-65).toString('base64url'));console.log('privada:',privateKey.export({format:'jwk'}).d)"
#
# São só estas duas, ambas de servidor. O navegador também precisa da chave
# pública para se inscrever, mas ela é entregue pela função getVapidPublicKey
# em vez de uma variável VITE_ — o ambiente de produção recusa segredo com esse
# prefixo, por ser valor de build e não de runtime.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Opcional: e-mail de contato exigido pela RFC 8292. Padrão: mailto:suporte@zuvvi.app
VAPID_SUBJECT=
